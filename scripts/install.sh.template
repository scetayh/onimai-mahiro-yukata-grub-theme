#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -Eeo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

#-------------------------------------------------------------------------------
# Macros
#-------------------------------------------------------------------------------
readonly INSTALL_DIR_DEFAULT=/boot/grub/themes/
readonly GRUB_DEFAULT_CONFIG=/etc/default/grub

#-------------------------------------------------------------------------------
# Business Functions
#-------------------------------------------------------------------------------
usage() {
    fmt -w "${MAXCOL}" -s >&2 << EOF
Usage: $0 [ option ]
$THEME_FRIENDLY_NAME installation script
Generated by '${SCRIPT_NAME}'.

Options:
  [Script information]
    -h, --help
      Display this help and exit.
    -V, --version
      Output version information and exit.
  [Installation]
    --install-dir=<directory>
      Specify the installation destination directory. [default:
      ${INSTALL_DIR_DEFAULT}]
    --skip-set-theme
      Skip appending the line that sets variable "GRUB_THEME" to the
      '${GRUB_DEFAULT_CONFIG}' file.
      Note: if this flag is specified, remember to modify the default file
      manually.
EOF
}

#-------------------------------------------------------------------------------
# Main Functions
#-------------------------------------------------------------------------------
main() {
    # >>> Stage A: Check command existence

    for cmd in grub-mkconfig; do
        command -v $cmd >& /dev/null || {
            echo_err "command '$cmd' not found"
            exit 1
        }
    done

    # >>> Stage B: Check work directory

    [[ "$(pwd -P)" = "$(cd "$(dirname "$0")" && pwd -P)" ]] || {
        echo_err "You should run this script from its own directory."
        exit 1
    }

    # >>> Stage C: Parse arguments

    short_opts=hV
    long_opts=help,version,install-dir:,skip-set-theme

    opts="$(getopt -o "$short_opts" -l "$long_opts" -n "$0" -- "$@")"
    eval set -- "$opts"

    declare -A flags params

    while true; do
        case "$1" in
            -h|--help)
                flags[h]=
                shift 1
                ;;
            -V|--version)
                flags[V]=
                shift 1
                ;;
            --install-dir)
                params["install-dir"]="$2"
                shift 2
                ;;
            --skip-set-theme)
                flags["skip-set-theme"]=
                shift 1
                ;;
            --)
                shift 1
                break
                ;;
            *)
                echo_err "unparsed option '$1'"
                return 1
                ;;
        esac
    done

    # >>> Stage D: Check arguments

    [[ -v flags[h] ]] && {
        usage
        return 0
    }

    [[ -v flags[V] ]] && {
        echo "${VERSION}"
        return 0
    }

    # >>> Stage E: Install theme

    install_dir=${params["install-dir"]:=${INSTALL_DIR_DEFAULT}}

    cp -rv "${THEME_DIR}" "$install_dir"

    cp -v "${GRUB_CUSTOM_CONFIG}" /etc/grub.d/

    [[ -v flags["skip-set-theme"] ]] || \
        echo "GRUB_THEME=\"$install_dir/${THEME_NAME}/theme.txt\"" \
            >> ${GRUB_DEFAULT_CONFIG}

    grub-mkconfig -o /boot/grub/grub.cfg
}

#-------------------------------------------------------------------------------
# Program Entry
#-------------------------------------------------------------------------------
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    echo_err "Do not 'source' this script. You should run it directly."
    exit 1
else
    main "$@"
    exit $?
fi